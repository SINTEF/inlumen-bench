#!/usr/bin/env bash
# One Ollama server per GPU, run as your own user (no sudo), so the bench can keep every
# GPU busy: each server sees one GPU and holds one model at a time.
#
#   scripts/ollama-gpus start     start a server per GPU (ports 11435, 11436, ...)
#   scripts/ollama-gpus stop      stop them
#   scripts/ollama-gpus status    show each server and the model it has loaded
#
# The servers read the models of the system Ollama (read only: nothing is downloaded,
# copied or deleted). Then list them as the profile's servers for runs, e.g.
#   bench providers add ollama --preset ollama \
#     --endpoint http://127.0.0.1:11435/v1 --endpoint http://127.0.0.1:11436/v1
# and run with as many runs in parallel as there are servers.
#
# Settings (environment): OLLAMA_GPUS_FIRST_PORT (11435), OLLAMA_GPUS_MODELS (the system
# Ollama's model folder), OLLAMA_GPUS_DIR (logs and pids, ~/.local/state/ollama-gpus),
# OLLAMA_GPUS (GPU indices, default: all GPUs nvidia-smi lists).
# The servers keep running after you log out, but not after a reboot.
set -euo pipefail

first_port=${OLLAMA_GPUS_FIRST_PORT:-11435}
models=${OLLAMA_GPUS_MODELS:-/usr/share/ollama/.ollama/models}
state=${OLLAMA_GPUS_DIR:-$HOME/.local/state/ollama-gpus}
gpus=${OLLAMA_GPUS:-$(nvidia-smi --query-gpu=index --format=csv,noheader | tr '\n' ' ')}

running() { [[ -f "$state/gpu$1.pid" ]] && kill -0 "$(cat "$state/gpu$1.pid")" 2>/dev/null; }

start() {
  mkdir -p "$state"
  local port=$first_port
  for gpu in $gpus; do
    if running "$gpu"; then
      echo "GPU $gpu: already running on 127.0.0.1:$port"
    else
      # CUDA_VISIBLE_DEVICES hides the other GPUs from CUDA; Ollama would still reach them
      # through Vulkan, so that is switched off. One model and one request at a time.
      CUDA_VISIBLE_DEVICES=$gpu OLLAMA_VULKAN=0 OLLAMA_HOST=127.0.0.1:$port OLLAMA_MODELS=$models \
        OLLAMA_NOPRUNE=1 OLLAMA_MAX_LOADED_MODELS=1 OLLAMA_NUM_PARALLEL=1 OLLAMA_KEEP_ALIVE=1h \
        setsid nohup ollama serve >>"$state/gpu$gpu.log" 2>&1 </dev/null &
      echo $! >"$state/gpu$gpu.pid"
      for _ in $(seq 30); do
        curl -fs "127.0.0.1:$port/api/version" >/dev/null && break
        sleep 1
      done
      curl -fs "127.0.0.1:$port/api/version" >/dev/null \
        && echo "GPU $gpu: started on http://127.0.0.1:$port/v1" \
        || { echo "GPU $gpu: did not start, see $state/gpu$gpu.log" >&2; exit 1; }
    fi
    port=$((port + 1))
  done
}

stop() {
  for gpu in $gpus; do
    if running "$gpu"; then
      kill "$(cat "$state/gpu$gpu.pid")" && echo "GPU $gpu: stopped"
    fi
    rm -f "$state/gpu$gpu.pid"
  done
}

status() {
  local port=$first_port
  for gpu in $gpus; do
    if running "$gpu"; then
      loaded=$(curl -fs "127.0.0.1:$port/api/ps" | python3 -c \
        'import json,sys; print(", ".join(m["name"] for m in json.load(sys.stdin)["models"]) or "no model loaded")')
      echo "GPU $gpu: http://127.0.0.1:$port/v1 · $loaded"
    else
      echo "GPU $gpu: not running"
    fi
    port=$((port + 1))
  done
}

case ${1:-status} in
  start) start ;;
  stop) stop ;;
  status) status ;;
  *) echo "usage: $0 start|stop|status" >&2; exit 2 ;;
esac
