#!/usr/bin/env bash
# Runs one `bench` command inside the Docker image, with the same folders as the
# dashboard started by `docker compose up`. Usage: scripts/bench-docker <bench arguments>
#
# Folders come from the environment, then from .env next to docker-compose.yml, then defaults:
#   BENCH_DATA_DIR    datasets (default ~/Documents/Datasets)
#   BENCH_RUNS_DIR    experiments (default ./runs in this repository)
#   BENCH_CONFIG_DIR  config and endpoint profiles (default ~/.config/inlumen-bench)
set -euo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

from_env_file() {  # Reads one BENCH_* setting from .env without sourcing the file.
  [[ -f "$repo/.env" ]] || return 0
  sed -n "s/^$1=[\"']\{0,1\}\([^\"']*\)[\"']\{0,1\}$/\1/p" "$repo/.env" | tail -n 1
}

BENCH_DATA_DIR="${BENCH_DATA_DIR:-$(from_env_file BENCH_DATA_DIR)}"
BENCH_RUNS_DIR="${BENCH_RUNS_DIR:-$(from_env_file BENCH_RUNS_DIR)}"
BENCH_CONFIG_DIR="${BENCH_CONFIG_DIR:-$(from_env_file BENCH_CONFIG_DIR)}"
BENCH_DATA_DIR="${BENCH_DATA_DIR:-$HOME/Documents/Datasets}"
BENCH_RUNS_DIR="${BENCH_RUNS_DIR:-$repo/runs}"
BENCH_CONFIG_DIR="${BENCH_CONFIG_DIR:-$HOME/.config/inlumen-bench}"

expand() { local p="${1/#\~/$HOME}"; mkdir -p "$p"; (cd "$p" && pwd -P); }
# Absolute, symlink-free paths: the host's Docker engine resolves them.
BENCH_DATA_DIR="$(expand "$BENCH_DATA_DIR")"
BENCH_RUNS_DIR="$(expand "$BENCH_RUNS_DIR")"
BENCH_CONFIG_DIR="$(expand "$BENCH_CONFIG_DIR")"
mkdir -p "$BENCH_RUNS_DIR/.tmp"
export BENCH_DATA_DIR BENCH_RUNS_DIR BENCH_CONFIG_DIR

# Compose reads the rest of .env (BENCH_NETWORK and so on) itself.
cd "$repo"
exec docker compose --progress quiet run --rm bench "$@"
