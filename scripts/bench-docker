#!/usr/bin/env bash
# Runs `bench` inside the Docker image with the host's folders mounted at the
# same absolute paths. Usage: scripts/bench-docker <bench arguments>
#
# Folders (override with environment variables):
#   BENCH_DATA_DIR    data folder; default: INLUMEN_BENCH_DATA_DIR, then data_dir
#                     from the config file, then the same platform default as `bench`
#   BENCH_RUNS_DIR    experiments; default: ./runs in this repository
#   BENCH_CONFIG_DIR  config and endpoint profiles; default: ~/.config/inlumen-bench
set -euo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
config_dir="${BENCH_CONFIG_DIR:-${INLUMEN_BENCH_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/inlumen-bench}}"

if [[ -z "${BENCH_DATA_DIR:-}" ]]; then
  if [[ -n "${INLUMEN_BENCH_DATA_DIR:-}" ]]; then
    BENCH_DATA_DIR="$INLUMEN_BENCH_DATA_DIR"
  elif [[ -f "$config_dir/config.toml" ]] && grep -q '^data_dir *=' "$config_dir/config.toml"; then
    BENCH_DATA_DIR="$(sed -n 's/^data_dir *= *"\(.*\)"$/\1/p' "$config_dir/config.toml")"
  elif [[ "$(uname)" == "Darwin" ]]; then
    BENCH_DATA_DIR="$HOME/Library/Application Support/inlumen-bench/datasets"
  else
    BENCH_DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/inlumen-bench/datasets"
  fi
fi
BENCH_DATA_DIR="${BENCH_DATA_DIR/#\~/$HOME}"
BENCH_RUNS_DIR="${BENCH_RUNS_DIR:-$repo/runs}"

mkdir -p "$BENCH_DATA_DIR" "$BENCH_RUNS_DIR" "$config_dir"
# Absolute, symlink-free paths: Docker resolves them on the host.
BENCH_DATA_DIR="$(cd "$BENCH_DATA_DIR" && pwd -P)"
BENCH_RUNS_DIR="$(cd "$BENCH_RUNS_DIR" && pwd -P)"
BENCH_CONFIG_DIR="$(cd "$config_dir" && pwd -P)"
export BENCH_DATA_DIR BENCH_RUNS_DIR BENCH_CONFIG_DIR
mkdir -p "$BENCH_RUNS_DIR/.tmp"

exec docker compose --progress quiet -f "$repo/compose.yaml" run --rm bench "$@"
